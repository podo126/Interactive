/* ---------- 레이어 2: 이미지 리소스 + 로프 + 표시 ---------- */
function drawSprites(t){
  const c=ic; c.clearRect(0,0,VW,VH);
  c.save(); c.translate(-Math.round(camX), -Math.round(camY));
  const vis=(x,w=40)=>x>camX-w && x<camX+VW+w;
  for(const k of CPS){ if(!vis(k.x)) continue; c.save(); if(k.i>S.cp) c.globalAlpha=.55; drawImg(c,'IMG-05',k.x+2,k.y-22,22,46); c.restore(); }
  if(vis(GOAL_X,60)) drawImg(c,'IMG-06',GOAL_X+TS/2+2,GOAL_Y-TS*3,34,26);
  if(S.phase!=='run') setMovers(Math.max(0,t),false);
  for(const m of MV){ if(!vis(m.x,m.w)) continue;
    if(m.dX>0.01) m.dir=1; else if(m.dX<-0.01) m.dir=-1;
    const g=IMAGES['IMG-07']._img;
    if(imgReady(g)){ const dw=m.w*1.3, dh=dw*g.naturalHeight/g.naturalWidth, flap=Math.sin(now()/180+m.i)*1.5;
      c.save(); const dx=m.x+m.w/2-dw/2, dy=m.y-dh*0.38+flap;
      if(flipFor('IMG-07',m.dir||-1)){ c.translate(dx+dw,dy); c.scale(-1,1); c.drawImage(g,0,0,dw,dh); } else c.drawImage(g,dx,dy,dw,dh); c.restore(); }
    else drawImg(c,'IMG-07',m.x,m.y,m.w,m.h); }
  const coinReal=imgReady(IMAGES['IMG-03']._img);
  for(const o of COINS){ if(S.coins.has(o.i)||!vis(o.x)) continue;
    if(coinReal){ const b=Math.sin(t*3+o.i)*2; drawImg(c,'IMG-03',o.x-13,o.y-11+b,26,20); }
    else { const sq=Math.abs(Math.cos(t*3+o.i)); drawImg(c,'IMG-03',o.x-8*sq-2,o.y-10,16*sq+4,20); } }
  for(const e of ENEMIES){ if(S.kills.has(e.i)) continue; const x=enemyX(e,t); if(!vis(x)) continue; drawImg(c,'IMG-04',x,e.y,e.w,e.h,enemyDir(e,t)<0); }
  // 로프
  const a=S.disp.P1, b=S.disp.P2, ax=a.x+PHYS.W/2, ay=a.y+PHYS.H/2, bx=b.x+PHYS.W/2, by=b.y+PHYS.H/2, d=Math.hypot(bx-ax,by-ay);
  if(S.ropeBroken){                                   // 끊어진 줄: 양쪽에 짧게 늘어진 조각
    const k=Math.min(1,(now()-S.snapAt)/400), sw=Math.sin(now()/120)*6;
    c.strokeStyle='#c46a3c'; c.lineWidth=3; c.lineCap='round';
    for(const [sx,sy,tx,ty] of [[ax,ay,bx,by],[bx,by,ax,ay]]){ const L=Math.hypot(tx-sx,ty-sy)||1, len=44;
      const ex=sx+(tx-sx)/L*len*(1-k)+sw*k, ey=sy+(ty-sy)/L*len*(1-k)+len*k;
      c.beginPath(); c.moveTo(sx,sy); c.quadraticCurveTo((sx+ex)/2+sw,(sy+ey)/2,ex,ey); c.stroke(); }
  } else {
    const sag=Math.max(0,ROPE.REST+30-d)*.7, tension=clamp((d-ROPE.REST)/(ROPE.MAX-ROPE.REST),0,1), st=S.strain;
    const blink = st>=ROPE.WARN && Math.floor(now()/(160-st*90))%2;
    c.strokeStyle = blink ? '#ff2d2d' : `rgb(${Math.round(150+105*Math.max(tension,st))},${Math.round(110-80*st)},${Math.round(70-40*st)})`;
    c.lineWidth = 3 - st*1.4; c.lineCap='round';
    c.beginPath(); c.moveTo(ax,ay); c.quadraticCurveTo((ax+bx)/2,(ay+by)/2+sag,bx,by); c.stroke();
    if(st>0.03){                                       // 과부하 게이지 (줄 가운데)
      const mx=(ax+bx)/2, my=(ay+by)/2+sag/2-14, w=36;
      c.fillStyle='rgba(20,20,40,.7)'; rr(c,mx-w/2-2,my-4,w+4,8,4); c.fill();
      c.fillStyle = st<.4?'#57e3a6':st<ROPE.WARN?'#ffcf4a':'#ff4d4d'; rr(c,mx-w/2,my-2,w*Math.min(1,st),4,2); c.fill();
      if(st>=ROPE.WARN){ c.fillStyle='#fff'; c.font='10px sans-serif'; c.textAlign='center'; c.fillText('⚠', mx, my-8); }
    }
  }
  // 캐릭터
  const deadBlink=now()<S.deadUntil && Math.floor(now()/90)%2;
  for(const id of [other(S.me),S.me]){
    const p=S.disp[id], cfg=PLAYERS[id], face=isLocal(id)?S.pl[id].face:(S.remote&&S.remote.face)||1;
    c.save(); if(deadBlink) c.globalAlpha=.25;
    const air = isLocal(id) ? !S.pl[id].grounded : !(S.remote && S.remote.grounded);
    const real = imgReady(IMAGES[cfg.img]._img);
    let top = p.y;
    if(real) top = drawChar(c,cfg.img,p.x+PHYS.W/2,p.y+PHYS.H+1,flipFor(cfg.img,face),air);
    else drawImg(c,cfg.img,p.x-2,p.y-2,PHYS.W+4,PHYS.H+2,face<0);
    const tw=24,th=13,ty=top-15; c.fillStyle=cfg.color; rr(c,p.x+PHYS.W/2-tw/2,ty,tw,th,6); c.fill();
    if(S.mode!=='solo'&&id===S.me){ c.strokeStyle='#fff'; c.lineWidth=1.5; c.stroke(); }
    c.fillStyle='#fff'; c.font='10px sans-serif'; c.textAlign='center'; c.textBaseline='middle'; c.fillText(id,p.x+PHYS.W/2,ty+th/2+1);
    c.restore();
  }
  S.fx=S.fx.filter(f=>now()-f.t0<800);
  for(const f of S.fx){ const k=(now()-f.t0)/800; c.globalAlpha=1-k; c.fillStyle=f.color; c.strokeStyle='rgba(0,0,0,.5)'; c.lineWidth=3;
    c.font='15px Jua, sans-serif'; c.textAlign='center'; c.strokeText(f.text,f.x,f.y-k*20); c.fillText(f.text,f.x,f.y-k*20); }
  c.globalAlpha=1; c.restore();
  // 화면 밖 친구 방향 표시
  for(const id of ['P1','P2']){ const p=S.disp[id], sy=p.y-camY;
    if(sy<-10||sy>VH){ const sx=clamp(p.x-camX+PHYS.W/2,12,VW-12), up=sy<0; c.fillStyle=PLAYERS[id].color;
      c.beginPath(); c.moveTo(sx, up?6:VH-6); c.lineTo(sx-8, up?18:VH-18); c.lineTo(sx+8, up?18:VH-18); c.fill(); } }
  if(S.phase==='count'){ const n=Math.ceil(-t);
    c.fillStyle='rgba(28,35,64,.35)'; c.fillRect(0,0,VW,VH); c.fillStyle='#fff'; c.textAlign='center'; c.textBaseline='middle';
    c.font='86px Jua, sans-serif'; c.fillText(n>0?n:'',VW/2,VH/2-24);
    c.font='17px Jua, sans-serif';
    c.fillText(S.mode==='solo' ? 'P1: A D 이동 · W 점프   /   P2: ← → 이동 · ↑ 점프' : `당신은 ${S.me}! 길게 누르면 높이 점프`, VW/2, VH/2+36); }
}

/* =========================================================
   메인 루프 (고정 프레임 물리 1/120초)
   ========================================================= */
const DT=1/120; let acc=0, lastFrame=now(), lastBeat=0;
function loop(){
  const tNow=now(), frame=Math.min(.1,(tNow-lastFrame)/1000); lastFrame=tNow;
  if(S.phase!=='idle'){
    const t=gameTime();
    if(S.phase==='count'){ const n=Math.ceil(-t); if(n!==lastBeat&&n>0){ lastBeat=n; sfx(440,.1,'square',.04); }
      if(t>=0){ S.phase='run'; lastBeat=0; acc=0; sfx(880,.2,'square',.04); toast('출발!',900); } }
    if(S.phase==='run' && now()>=S.deadUntil){
      acc+=frame;
      while(acc>=DT){ S.mvT+=DT; if(Math.abs(S.mvT-gameTime())>0.15) S.mvT=gameTime(); setMovers(S.mvT,true); updateDoor(); for(const id of localIds()) if(S.phase==='run' && now()>=S.deadUntil) stepBody(id,DT); updateStrain(DT); acc-=DT; }
      strainFeedback();
    } else acc=0;
    // 표시 위치: 내 캐릭터는 그대로, 상대는 부드럽게 보간
    for(const id of localIds()){ S.disp[id]={x:S.pl[id].x, y:S.pl[id].y}; }
    if(S.mode!=='solo' && S.remote){ const o=other(S.me), r=S.remote, age=Math.min(.12,(now()-r.at)/1000), d=S.disp[o], k=Math.min(1,frame*14);
      d.x+=(r.x+r.vx*age-d.x)*k; d.y+=(r.y+r.vy*age*.5-d.y)*k;
      const box={x:d.x,y:d.y,w:PHYS.W,h:PHYS.H}; if(solidHit(box)){ unstick(box); d.x=box.x; d.y=box.y; } }
    // 상태 전송 (초당 20회)
    if(S.mode!=='solo' && S.phase==='run' && tNow-net.lastSend>50){ net.lastSend=tNow; const p=S.pl[S.me];
      const msg={t:'s',x:Math.round(p.x*10)/10,y:Math.round(p.y*10)/10,vx:Math.round(p.vx),vy:Math.round(p.vy),g:p.grounded?1:0,f:p.face};
      if(S.mode==='host') msg.r=Math.round(S.strain*1000)/1000;
      net.send(msg); }
    // 카메라: 두 캐릭터의 중간
    const mid=(S.disp.P1.x+S.disp.P2.x)/2+PHYS.W/2, target = VW>=WORLD_W ? (WORLD_W-VW)/2 : clamp(mid-VW*.5,0,WORLD_W-VW);
    camX += (target-camX)*Math.min(1,frame*8);
    const midY=(S.disp.P1.y+S.disp.P2.y)/2+PHYS.H/2, targetY=clamp(midY-VH*.5,0,WORLD_H-VH);
    camY += (targetY-camY)*Math.min(1,frame*6);
    drawWorld(t); drawSprites(t);
    const cur=Math.max(heightM(S.disp.P1.y),heightM(S.disp.P2.y));
    $('#hudHeight').textContent=`🧗 ${cur}m / ${S.best}m`;
    $('#hudFalls').textContent='😱 '+S.falls;
    $('#hudCoins').textContent=`🪙 ${S.coins.size}/${COINS.length}`;
    $('#hudTime').textContent='⏱ '+fmt(Math.max(0,t));
  }
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
</script>
