function drawImg(c,key,x,y,w,h,flip,variant){
  const im=IMAGES[key], src = (variant==='jump' && imgReady(im._jump)) ? im._jump : im._img;
  if(imgReady(src)){                                   // 비율 유지, 박스 아래-가운데 기준
    const sc=Math.min(w/src.naturalWidth, h/src.naturalHeight), dw=src.naturalWidth*sc, dh=src.naturalHeight*sc;
    const dx=x+(w-dw)/2, dy=y+h-dh;
    c.save(); if(flip){ c.translate(dx+dw,dy); c.scale(-1,1); c.drawImage(src,0,0,dw,dh); } else c.drawImage(src,dx,dy,dw,dh); c.restore(); return;
  }
  c.save(); c.globalAlpha=.55; c.fillStyle=im.tint; rr(c,x,y,w,h,Math.min(w,h)*.18); c.fill();
  c.globalAlpha=.95; c.strokeStyle='#fff'; c.lineWidth=1.2; c.setLineDash([3,2]); c.stroke(); c.setLineDash([]);
  c.globalAlpha=1; c.fillStyle='#fff'; c.font=`${Math.max(8,Math.round(Math.min(w,h)*.34))}px sans-serif`;
  c.textAlign='center'; c.textBaseline='middle'; c.fillText(key.replace('IMG-','#'),x+w/2,y+h/2); c.restore();
}
function drawChar(c,key,cx,feetY,flip,jump){        // 몸통 기준 크기·위치로 캐릭터 그리기 → 그림 윗변 y 반환
  const im=IMAGES[key], useJ = jump && imgReady(im._jump), src = useJ ? im._jump : im._img;
  const body = (useJ ? im.jumpBody : im.body) || src.naturalWidth*0.8, bcx = (useJ ? im.jumpCX : im.bodyCX) ?? 0.5;
  const sc=CHAR_BODY/body, dw=src.naturalWidth*sc, dh=src.naturalHeight*sc;
  const dx = cx - dw*(flip ? 1-bcx : bcx), dy = feetY - dh;
  c.save(); if(flip){ c.translate(dx+dw,dy); c.scale(-1,1); c.drawImage(src,0,0,dw,dh); } else c.drawImage(src,dx,dy,dw,dh); c.restore();
  return dy;
}
const flipFor = (key, face) => IMAGES[key].faceLeft ? face>0 : face<0;   // 바라보는 방향에 맞춰 반전

