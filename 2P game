<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#1c2340">
<title>듀오 로프 - 2인 협동 플랫포머</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet">
<!-- 온라인 2인 연결 (WebRTC P2P) -->
<script src="https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js"></script>
<style>
/* =========================================================
   디자인 토큰
   ========================================================= */
:root{
  --bg:#1c2340; --panel:#283157; --line:#3c4777; --text:#f3f5ff; --muted:#a3abd1;
  --p1:#ff5d5d; --p2:#3ea8ff; --gold:#ffcf4a;
  --font:'Jua',-apple-system,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;
  --key:clamp(58px,16vw,78px);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:var(--bg);color:var(--text);font-family:var(--font);overflow:hidden;
  overscroll-behavior:none;touch-action:manipulation;-webkit-user-select:none;user-select:none;
  -webkit-touch-callout:none;-webkit-tap-highlight-color:transparent}
button{font-family:inherit;color:inherit;cursor:pointer;border:0;background:none}
button:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
[hidden]{display:none!important}
.btn{display:block;width:100%;padding:14px 16px;border-radius:14px;font-size:1.05rem;background:var(--panel);border:2px solid var(--line)}
.btn:active{transform:scale(.97)}
.btn.primary{background:var(--gold);border-color:var(--gold);color:#2b2000}
.btn.ghost{background:transparent;border-color:transparent;color:var(--muted);font-size:.95rem}
.muted{color:var(--muted)}
kbd{font-family:inherit;background:var(--bg);border:1px solid var(--line);border-radius:5px;padding:0 5px}

/* ---------- 이미지 교체 슬롯 (DOM) ---------- */
.img-slot{display:grid;place-items:center;border-radius:10px;font-size:.7rem;color:#fff;overflow:hidden;
  background:color-mix(in srgb,var(--tint,#fff) 35%,transparent);border:2px dashed rgba(255,255,255,.55)}
.img-slot{position:relative}
.img-slot img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block}
.img-slot.filled{background:none;border:0}

/* =========================================================
   로비
   ========================================================= */
#lobby{position:fixed;inset:0;overflow-y:auto;display:flex;justify-content:center;
  padding:calc(env(safe-area-inset-top,0px) + 24px) 18px calc(env(safe-area-inset-bottom,0px) + 32px)}
.lobby-inner{width:min(100%,380px);display:flex;flex-direction:column;gap:12px;text-align:center;margin:auto 0}
.logo{width:110px;height:110px;margin:0 auto;--tint:var(--gold)}
h1{font-size:2.5rem;font-weight:400;line-height:1.05}
.sub{color:var(--muted);margin-top:-4px}
.roles{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.role{background:var(--panel);border-radius:16px;padding:12px 8px;display:flex;flex-direction:column;align-items:center;gap:5px;border:2px solid}
.role .img-slot{width:52px;height:52px}
.role.p1{border-color:var(--p1)} .role.p1 .img-slot{--tint:var(--p1)}
.role.p2{border-color:var(--p2)} .role.p2 .img-slot{--tint:var(--p2)}
.role small{color:var(--muted);font-size:.78rem}
.rules{list-style:none;font-size:.88rem;color:var(--muted);line-height:1.6}
.join{display:flex;gap:8px}
.join input{flex:1;min-width:0;padding:12px;border-radius:14px;border:2px solid var(--line);background:var(--panel);color:var(--text);
  font-family:inherit;font-size:1.4rem;text-align:center;letter-spacing:8px;text-transform:uppercase}
.join .btn{width:auto;flex:none;padding:12px 18px}
.status{min-height:1.4em;font-size:.9rem;color:var(--gold)}

/* =========================================================
   게임 화면
   ========================================================= */
#game{position:fixed;inset:0;display:flex;flex-direction:column;
  padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) env(safe-area-inset-bottom,0px) env(safe-area-inset-left,0px)}
#hud{flex:none;display:flex;align-items:center;gap:6px;padding:8px 10px;overflow-x:auto}
.pill{padding:5px 10px;border-radius:999px;background:var(--panel);font-size:.9rem;white-space:nowrap}
#hudMe{color:#fff}
#hud .sp{flex:1}
.icon-btn{width:36px;height:36px;border-radius:10px;background:var(--panel);font-size:1rem;flex:none}
@media (max-width:420px){ #hud{gap:4px;padding:8px 6px} .pill{padding:5px 7px;font-size:.78rem} .icon-btn{width:32px;height:32px} #hudCoins{display:none} }

#main{flex:1;min-height:0;display:flex;flex-direction:column}
#stage{flex:1;min-height:0;display:grid;place-items:center;padding:4px 6px}
#board{position:relative;border-radius:12px;overflow:hidden;box-shadow:0 0 0 3px var(--line)}
#board canvas{position:absolute;left:0;top:0;display:block}
#layer-images{pointer-events:none}

/* ---------- 모바일 조작 버튼 (게임 화면과 분리된 영역) ---------- */
#controls{display:none;flex:none;justify-content:space-between;align-items:center;padding:8px 18px 14px}
body.touch #controls{display:flex}
.move{display:flex;gap:10px;touch-action:none}
.key{width:var(--key);height:var(--key);border-radius:20px;font-size:1.5rem;touch-action:none;
  background:rgba(255,255,255,.09);border:3px solid rgba(255,255,255,.2);display:grid;place-items:center}
.move .key{pointer-events:none}
.key.on{background:color-mix(in srgb,var(--c,#ffcf4a) 45%,transparent);border-color:var(--c,#ffcf4a)}
.key.jump{width:calc(var(--key)*1.35);height:calc(var(--key)*1.35);border-radius:50%;font-size:1.15rem}
@media (orientation:landscape){
  :root{--key:clamp(50px,17vh,76px)}
  body.touch #main{flex-direction:row}
  body.touch #controls{display:contents}
  body.touch .move{order:-1;align-self:center;gap:6px;padding:0 4px 0 12px}
  body.touch .key.jump{order:2;align-self:center;margin:0 14px 0 4px}
}

/* ---------- 오버레이 / 토스트 ---------- */
.overlay{position:fixed;inset:0;z-index:30;display:grid;place-items:center;padding:20px;background:rgba(12,15,32,.78)}
.card{width:min(100%,360px);background:var(--panel);border-radius:20px;padding:22px 18px;text-align:center;display:flex;flex-direction:column;gap:10px}
.card h2{font-weight:400;font-size:1.7rem}
.code{font-size:2.8rem;letter-spacing:12px;color:var(--gold);padding-left:12px}
.stars{font-size:2rem;color:var(--gold);letter-spacing:4px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:4px 0 6px}
.stats div{background:var(--bg);border-radius:12px;padding:10px 4px;display:flex;flex-direction:column}
.stats b{font-weight:400;font-size:1.2rem}
.stats span{font-size:.75rem;color:var(--muted)}
#toast{position:fixed;left:50%;top:calc(env(safe-area-inset-top,0px) + 58px);transform:translateX(-50%);z-index:40;
  background:rgba(40,49,87,.96);border:2px solid var(--line);padding:9px 16px;border-radius:999px;font-size:.95rem;
  white-space:nowrap;max-width:94vw;overflow:hidden;text-overflow:ellipsis;transition:opacity .25s;pointer-events:none}
#toast.hide{opacity:0}
</style>
</head>
<body>

<!-- ===================== 로비 ===================== -->
<section id="lobby">
  <div class="lobby-inner">
    <div class="img-slot logo" data-img="IMG-00"></div>
    <h1>듀오 로프</h1>
    <p class="sub">고무줄로 묶인 둘, 함께 200m 꼭대기까지. 떨어지면 아래로…</p>
    <div class="roles">
      <div class="role p1"><div class="img-slot" data-img="IMG-01"></div><b>P1 · 방장</b>
        <small><kbd>A</kbd><kbd>D</kbd> 이동 <kbd>W</kbd> 점프</small></div>
      <div class="role p2"><div class="img-slot" data-img="IMG-02"></div><b>P2 · 참여자</b>
        <small><kbd>←</kbd><kbd>→</kbd> 이동 <kbd>↑</kbd> 점프</small></div>
    </div>
    <ul class="rules">
      <li>체크포인트 없음! 떨어지면 거기서부터 다시</li>
      <li>점프 키를 오래 누를수록 높이 뛰어요</li>
      <li>🪢 오래 매달리거나 세게 당기면 줄이 <b>끊어져 탈락!</b></li>
      <li>높은 벽은 친구 머리를 밟고 넘어요</li>
      <li>친구가 위에 있으면 공중에서도 점프 (줄 타고 오르기)</li>
      <li>버튼을 밟는 동안 문이 열려요 · 얼음은 미끄러워요</li>
    </ul>
    <button class="btn primary" id="btnCreate">방 만들기 (코드 생성)</button>
    <div class="join">
      <input id="inCode" maxlength="4" placeholder="코드" autocomplete="off" autocapitalize="characters">
      <button class="btn" id="btnJoin">입장</button>
    </div>
    <button class="btn ghost" id="btnSolo">혼자 테스트 (한 기기로 P1·P2 조작)</button>
    <p class="status" id="lobbyStatus"></p>
  </div>
</section>

<!-- ===================== 게임 ===================== -->
<section id="game" hidden>
  <div id="hud">
    <span class="pill" id="hudMe">P1</span>
    <span class="pill" id="hudHeight">🧗 0m</span>
    <span class="pill" id="hudFalls">😱 0</span>
    <span class="pill" id="hudCoins">🪙 0</span>
    <span class="pill" id="hudTime">⏱ 00:00</span>
    <span class="sp"></span>
    <button class="icon-btn" id="btnSwap" hidden aria-label="조작 캐릭터 변경">⇄</button>
    <button class="icon-btn" id="btnRestart" aria-label="다시 시작">↻</button>
    <button class="icon-btn" id="btnExit" aria-label="나가기">✕</button>
  </div>
  <div id="main">
    <div id="stage">
      <div id="board">
        <!-- 레이어 1: 배경·지형 타일 (코드 드로잉) -->
        <canvas id="layer-world"></canvas>
        <!-- 레이어 2: 이미지 리소스 (반투명 박스 = 교체 대상) -->
        <canvas id="layer-images"></canvas>
      </div>
    </div>
    <div id="controls">
      <div class="move" id="movePad">
        <button class="key" data-dir="left" aria-label="왼쪽">◀</button>
        <button class="key" data-dir="right" aria-label="오른쪽">▶</button>
      </div>
      <button class="key jump" id="btnJump">점프</button>
    </div>
  </div>
</section>

<!-- 대기 (방장) -->
<div class="overlay" id="ovWait" hidden>
  <div class="card">
    <h2>친구를 기다리는 중</h2>
    <p class="muted">친구가 이 코드를 입력하면 시작해요</p>
    <div class="code" id="waitCode">----</div>
    <button class="btn primary" id="btnInvite">코드 보내기</button>
    <button class="btn ghost" id="btnCancelWait">취소</button>
  </div>
</div>

<!-- 결과 -->
<div class="overlay" id="ovResult" hidden>
  <div class="card">
    <div class="stars" id="resStars">★★★</div>
    <h2 id="resTitle">탈출 성공!</h2>
    <div class="stats">
      <div><b id="resA">00:00</b><span id="resALabel">기록</span></div>
      <div><b id="resB">0</b><span>최고 높이</span></div>
      <div><b id="resC">0</b><span>추락</span></div>
    </div>
    <button class="btn primary" id="btnShare">결과 공유하기</button>
    <button class="btn" id="btnRetry">다시 하기</button>
    <button class="btn ghost" id="btnHome">처음으로</button>
  </div>
</div>

<!-- 알림/오류 -->
<div class="overlay" id="ovMsg" hidden>
  <div class="card">
    <h2 id="msgTitle">알림</h2>
    <p class="muted" id="msgText"></p>
    <button class="btn primary" id="btnMsgOk">처음으로</button>
  </div>
</div>
<div id="toast" class="hide"></div>

<script>
/* =========================================================
   ① 이미지 리소스 (src만 채우면 반투명 박스 → 이미지로 교체)
   ========================================================= */
const IMAGES = {
  //  src  : 기본 이미지      jump : 점프(공중) 중 이미지      faceLeft : 원본 그림이 왼쪽을 보고 있으면 true (좌우 반전 기준)
  'IMG-00': { name:'타이틀 로고',     src:'', tint:'#ffcf4a' },
  'IMG-01': { name:'P1 캐릭터 (양파쿵야)', tint:'#ff5d5d', faceLeft:true,
              body:87, bodyCX:0.50, jumpBody:85, jumpCX:0.39,
              src:'data:image/webp;base64,',
              jump:'data:image/webp;base64,' },
  'IMG-02': { name:'P2 캐릭터', tint:'#3ea8ff', faceLeft:false,
              body:105, bodyCX:0.47, jumpBody:100, jumpCX:0.47,
              src:'data:image/webp;base64,',
              jump:'data:image/webp;base64,' },
  'IMG-03': { name:'코인 (지폐다발)', tint:'#ffcf4a',
              src:'data:image/webp;base64,' },
  'IMG-04': { name:'적 몬스터',       src:'', tint:'#9b59b6' },
  'IMG-05': { name:'체크포인트 깃발', src:'', tint:'#57e3a6' },
  'IMG-06': { name:'결승 깃발',       src:'', tint:'#ffffff' },
  'IMG-07': { name:'이동 발판 (갈매기)', tint:'#c08cff', faceLeft:true,
              src:'data:image/webp;base64,' },
  'IMG-08': { name:'시작 배경 건물',  tint:'#4aa3c9',
              src:'data:image/webp;base64,' },
};
// 캐릭터 크기 맞춤: 이미지 속 '몸통 덩어리' 폭을 기준으로 두 캐릭터를 같은 크기로 그림
//  body / jumpBody : 원본 이미지에서 몸통(귀·팔·다리·소품 제외) 폭(px)
//  bodyCX / jumpCX : 이미지 폭 대비 몸통 중심 위치(0~1) — 소품 때문에 한쪽으로 치우친 그림 보정
//  이미지를 바꾸면 이 값만 다시 맞추면 됨
const CHAR_BODY = 32;   // 화면에 그려질 몸통 폭(px)
// 시작 지점 배경 건물 위치 (칸 단위, 바닥 위에 세워짐, 충돌 없음)
const START_DECOR = { img:'IMG-08', x:10.5, w:9 };

/* =========================================================
   ② 플레이어 & 키 설정
   ========================================================= */
const PLAYERS = {
  P1: { color:'#ff5d5d', img:'IMG-01', keys:{ left:'KeyA',      right:'KeyD',       jump:'KeyW' } },
  P2: { color:'#3ea8ff', img:'IMG-02', keys:{ left:'ArrowLeft', right:'ArrowRight', jump:'ArrowUp' } },
};

/* =========================================================
   ③ 물리 수치 (단위: px, 초) — 타일 24px, 화면 높이 360px
   점프: 누르는 동안 중력 감소(최대 HOLD_T초) → 길게 누를수록 높이
         최대 높이 ≈ 100px(약 4칸), 짧게 탭 ≈ 10~20px
   ========================================================= */
const PHYS = {
  TILE:24, W:20, H:28,
  GRAVITY:1800, MAX_FALL:640,
  RUN:150, ACCEL:1500, AIR_ACCEL:1000, FRICTION:1800,
  JUMP_V:390,        // 점프 시작 속도
  HOLD_GRAV:0.3,     // 누르고 있는 동안 중력 배율
  HOLD_T:0.26,       // 높이가 계속 오르는 최대 누름 시간 (= 높이 상한)
  CUT:0.45,          // 손을 떼면 상승 속도 감소 배율
  COYOTE:0.08, BUFFER:0.1,
  STOMP_V:300,       // 적 밟았을 때 튕김
  ICE_ACCEL:0.35, ICE_FRICTION:110,  // 얼음 위: 가속 배율 / 마찰
  SPRING_V:820,      // 점프대 튕김 속도 (약 7.5칸)
};
const ROPE = {
  REST:130,          // 이 길이까지는 느슨함
  MAX:200,           // 최대 길이 (더 늘어나지 않음)
  K:8, AMAX:900,     // 고무줄 탄성
  ASSIST_DY:30,      // 친구가 이만큼 위에 서 있으면 공중에서 점프 가능 (줄 타고 오르기)
  ASSIST_CD:0.3,     // 로프 점프 재사용 대기(초)
  // ── 로프 과부하 (끊어지면 탈락) ──
  BREAK:true,        // false로 바꾸면 끊어지지 않음
  HANG_LIMIT:4.0,    // 한 명이 줄에 매달린 채 버틸 수 있는 시간(초) = 게이지 100%
  RECOVER:0.35,      // 줄이 느슨하거나 둘 다 발판 위일 때 초당 회복량
  JERK_MIN:260,      // 이 속도 이상으로 '확' 당겨지면 충격 누적 (px/s)
  JERK_DIV:1800,     // 충격 → 게이지 환산 (클수록 덜 쌓임)
  WARN:0.6,          // 경고 시작 (60%)
};
const GAME = {
  COUNTDOWN:3200,
  FALL_TILES:6,      // 이 칸 수 이상 떨어지면 '추락'으로 기록
  METER_PER_TILE:1,  // 높이 표시 (1칸 = 1m)
};

/* =========================================================
   ④ 스테이지 맵 — 세로 등반형 200m (40 x 212칸, 아래에서 위로)
   체크포인트 없음: 떨어지면 떨어진 곳에서 다시 올라가야 함
   모든 발판은 아래에서 통과 불가 (줄 타고 올라와도 머리가 막힘 → 옆으로 돌아서 올라가야 함)
   # 바위   B 돌 블록   P 나무 그루터기   = 나무 발판   ~ 얼음(미끄러움)
   S 점프대   b 버튼   d 문/해치 (누군가 버튼을 밟고 있으면 열림)
   o 코인   G 정상 깃발   1 P1 시작   2 P2 시작
   (선택) ^ 가시   L 용암   e 적   C 체크포인트 — 넣으면 동작함
   ========================================================= */
const MAP = [
  "#                                      #",
  "#                                      #",
  "#                                      #",
