      c.fillStyle='#8fd0f2'; c.fillRect(X,Y+TS-4,TS,4); c.strokeStyle='rgba(255,255,255,.9)'; c.lineWidth=2;
      c.beginPath(); c.moveTo(X+4+((tx*5)%8),Y+10); c.lineTo(X+10+((tx*5)%8),Y+16); c.stroke(); }
    else if(ch==='='){ const lf=tileAt(tx-1,ty)==='=', rt=tileAt(tx+1,ty)==='=';   // 나무 발판 (단단함)
      c.fillStyle='#a8743f'; c.fillRect(X,Y+2,TS,TS-4); c.fillStyle='#c9965a'; c.fillRect(X,Y+2,TS,5);
      c.fillStyle='#7d5229'; c.fillRect(X,Y+TS-5,TS,3); c.fillRect(X,Y+12,TS,1.5);
      if(!lf){ c.fillStyle='#7d5229'; c.fillRect(X,Y+2,3,TS-4); } if(!rt){ c.fillStyle='#7d5229'; c.fillRect(X+TS-3,Y+2,3,TS-4); }
      c.fillStyle='#5e3b1c'; c.beginPath(); c.arc(X+6,Y+9,1.5,0,Math.PI*2); c.arc(X+TS-6,Y+9,1.5,0,Math.PI*2); c.fill(); }
    else if(ch==='^'){ c.fillStyle='#d6dbe6'; for(let k=0;k<3;k++){ c.beginPath(); c.moveTo(X+k*8,Y+TS); c.lineTo(X+k*8+4,Y+10); c.lineTo(X+k*8+8,Y+TS); c.fill(); }
      c.fillStyle='#9aa3b5'; c.fillRect(X,Y+TS-3,TS,3); }
    else if(ch==='L'){ const top=tileAt(tx,ty-1)!=='L';
      c.fillStyle='#e8461f'; c.fillRect(X,Y,TS,TS); c.fillStyle='#ff8a2a';
      if(top){ c.beginPath(); c.moveTo(X,Y+8); for(let i=0;i<=6;i++) c.lineTo(X+i*4, Y+5+Math.sin(t*4+tx*1.3+i)*3); c.lineTo(X+TS,Y+12); c.lineTo(X,Y+12); c.fill();
        c.fillStyle='#ffd25a'; c.fillRect(X+((t*20+tx*7)%18),Y+10,3,3); }
      else { c.fillRect(X+((tx*9)%14),Y+((ty*7+t*8)%20),4,4); } }
    else if(ch==='S'){ const sq=Math.max(0,1-(now()-(S.springAt||0))/200)*6;
      c.fillStyle='#555d78'; c.fillRect(X+2,Y+TS-6,TS-4,6);
      c.strokeStyle='#cfd5e6'; c.lineWidth=2; c.beginPath(); for(let i=0;i<4;i++){ c.moveTo(X+5,Y+10+sq+i*3); c.lineTo(X+TS-5,Y+11+sq+i*3); } c.stroke();
      c.fillStyle='#ff5d8f'; rr(c,X+1,Y+4+sq,TS-2,6,3); c.fill(); }
    else if(ch==='b'){ const on=DOOR.open; c.fillStyle='#4b4f6b'; c.fillRect(X+2,Y+TS-4,TS-4,4);
      c.fillStyle=on?'#ffe48a':'#ffcf4a'; rr(c,X+4,Y+TS-(on?7:11),TS-8,on?4:8,2); c.fill(); }
    else if(ch==='d'){
      if(DOOR.open){ c.strokeStyle='rgba(180,140,255,.45)'; c.setLineDash([4,4]); c.lineWidth=2; c.strokeRect(X+4,Y,TS-8,TS); c.setLineDash([]); }
      else { c.fillStyle='#6d4bc4'; c.fillRect(X+3,Y,TS-6,TS); c.fillStyle='#b48cff'; c.fillRect(X+7,Y,3,TS); c.fillRect(X+14,Y,3,TS);
        if(tileAt(tx,ty+1)!=='d'){ c.fillStyle='#ffcf4a'; c.beginPath(); c.arc(X+TS/2,Y+TS/2,4,0,Math.PI*2); c.fill(); } } }
