function moveX(p,dx){
  const n=Math.ceil(Math.abs(dx)/8)||1, s=dx/n;
  for(let i=0;i<n;i++){
    p.x+=s;
    const ty0=Math.floor(p.y/TS), ty1=Math.floor((p.y+p.h-1)/TS);
    const tx = s>0 ? Math.floor((p.x+p.w-1)/TS) : Math.floor(p.x/TS);
    for(let ty=ty0; ty<=ty1; ty++) if(isSolid(tileAt(tx,ty))){
      p.x = s>0 ? tx*TS-p.w : (tx+1)*TS; p.vx=0; return; }
    if(s!==0) for(const m of MV) if(p.x<m.x+m.w && p.x+p.w>m.x && p.y<m.y+m.h-4 && p.y+p.h>m.y+4){   // 발판 옆면 (윗면에 살짝 닿은 건 제외)
      p.x = s>0 ? m.x-p.w : m.x+m.w; p.vx=0; return; }
  }
}
function moveY(p,dy,partner){
  const n=Math.ceil(Math.abs(dy)/8)||1, s=dy/n;
  for(let i=0;i<n;i++){
    const prevBottom=p.y+p.h; p.y+=s;
    const tx0=Math.floor(p.x/TS), tx1=Math.floor((p.x+p.w-1)/TS);
    if(s>0){
      const ty=Math.floor((p.y+p.h-0.01)/TS), top=ty*TS;
      for(let tx=tx0; tx<=tx1; tx++){ const c=tileAt(tx,ty);
        if(c==='S'){ p.y=top-p.h; p.vy=-PHYS.SPRING_V; p.holding=false; p.airUsed=false; S.springAt=now(); sfx(300,.18,'sine',.07); sfx(600,.18,'sine',.04); return; }
        if(isSolid(c) || (c==='=' && prevBottom<=top+.5)){ p.y=top-p.h; p.gTile=c; land(p,false); return; } }
      for(const m of MV) if(p.x+p.w>m.x+1 && p.x<m.x+m.w-1 && prevBottom<=m.y+Math.abs(m.dY)+1 && p.y+p.h>=m.y){
        p.y=m.y-p.h; p.gTile='mover'; land(p,false); p.onMover=m.i; return; }
      // 친구 머리 = 밟을 수 있는 발판
      if(partner && prevBottom<=partner.y+8 && p.y+p.h>=partner.y && p.x+p.w>partner.x+3 && p.x<partner.x+partner.w-3){
        if(!solidHit({x:p.x, y:partner.y-p.h, w:p.w, h:p.h})){ p.y=partner.y-p.h; p.gTile='head'; land(p,true); return; } }
    } else if(s<0){
      const ty=Math.floor(p.y/TS);
      for(let tx=tx0; tx<=tx1; tx++) if(isSolid(tileAt(tx,ty))){ p.y=(ty+1)*TS; p.vy=0; p.holding=false; return; }
      for(const m of MV) if(p.x+p.w>m.x && p.x<m.x+m.w && p.y<m.y+m.h && p.y+p.h>m.y+m.h){ p.y=m.y+m.h; p.vy=0; p.holding=false; return; }
    }
  }
}
// ---- 끼임 방지: 몸이 벽 안에 들어가면 가장 가까운 빈 곳으로 밀어냄 ----
function solidHit(b){
  const tx0=Math.floor(b.x/TS), tx1=Math.floor((b.x+b.w-0.01)/TS), ty0=Math.floor(b.y/TS), ty1=Math.floor((b.y+b.h-0.01)/TS);
  for(let ty=ty0;ty<=ty1;ty++) for(let tx=tx0;tx<=tx1;tx++) if(isSolid(tileAt(tx,ty))) return {x:tx*TS,y:ty*TS,w:TS,h:TS};
  for(const m of MV) if(b.x<m.x+m.w && b.x+b.w>m.x && b.y<m.y+m.h && b.y+b.h>m.y) return m;
  return null;
}
function unstick(b, maxMove=Infinity){
  const ox=b.x, oy=b.y;
  for(let k=0;k<6;k++){
    const r=solidHit(b); if(!r) return true;
    const opts=[['x',r.x-(b.x+b.w)],['x',r.x+r.w-b.x],['y',r.y-(b.y+b.h)],['y',r.y+r.h-b.y]]
      .sort((a,c)=>Math.abs(a[1])-Math.abs(c[1]));
    const pick = opts.find(([ax,v])=>!solidHit({x:b.x+(ax==='x'?v:0), y:b.y+(ax==='y'?v:0), w:b.w, h:b.h})) || opts[0];
    const [ax,v]=pick; b[ax]+=v;
    if(Math.abs(b.x-ox)+Math.abs(b.y-oy) > maxMove){ b.x=ox; b.y=oy; return false; }
    if(ax==='x' && b.vx!==undefined && Math.sign(b.vx)===-Math.sign(v)) b.vx=0;
    if(ax==='y' && b.vy!==undefined && Math.sign(b.vy)===-Math.sign(v)) b.vy=0;
  }
  return !solidHit(b);
}
function land(p,onPartner){
  if(!p.grounded && p.id && isLocal(p.id) && S.phase==='run'){        // 추락 판정 (최고점 → 착지 높이)
    const drop=(p.y-p.peakY)/TS;
    if(drop>=GAME.FALL_TILES) registerFall(p.id, Math.round(drop*GAME.METER_PER_TILE), true);
  }
  p.vy=0; p.grounded=true; p.onPartner=onPartner; p.airUsed=false; p.peakY=p.y;
}
/* ---------- 로프 과부하 ----------
   게이지(S.strain 0~1)가 1이 되면 끊어짐
   · 쌓임: 한 명은 발판 위, 다른 한 명은 줄에 매달려 아래에 있을 때 (초당 1/HANG_LIMIT)
   · 쌓임: 떨어지다 줄에 '확' 걸릴 때 충격량만큼
   · 회복: 줄이 느슨하거나 매달린 사람이 없을 때
   판정은 솔로/방장 기기에서만 하고 참여자에게 게이지를 전송 */
const ropeJudge = () => ROPE.BREAK && (S.mode==='solo' || S.mode==='host');
function ropeJerk(v){
  if(!ROPE.BREAK || S.ropeBroken || v<ROPE.JERK_MIN || S.phase!=='run') return;
  const add=(v-ROPE.JERK_MIN)/ROPE.JERK_DIV;
  if(ropeJudge()) addStrain(add); else net.send({t:'jerk',a:add});
}
function addStrain(a){ if(S.ropeBroken) return; S.strain=Math.max(0,S.strain+a); if(S.strain>=1) snapRope(); }
function updateStrain(dt){
  if(!ropeJudge() || S.ropeBroken || S.phase!=='run') return;
  const A = S.mode==='solo' ? S.pl.P1 : S.pl[S.me], B = S.mode==='solo' ? S.pl.P2 : partnerOf(S.me);
  if(!B) return;
  const d=Math.hypot((A.x+A.w/2)-(B.x+B.w/2),(A.y+A.h/2)-(B.y+B.h/2));
  const taut = d >= ROPE.MAX-6;
  const hanging = taut && ((A.grounded && !B.grounded && B.y > A.y+20) || (B.grounded && !A.grounded && A.y > B.y+20));
  if(hanging) addStrain(dt/ROPE.HANG_LIMIT);
  else S.strain=Math.max(0, S.strain-ROPE.RECOVER*dt);
}
function snapRope(){
  if(S.ropeBroken) return;
  S.ropeBroken=true; S.snapped=true; S.strain=1; S.snapAt=now();
  sfx(90,.5,'sawtooth',.1); sfx(1400,.08,'square',.06); if(navigator.vibrate) navigator.vibrate([60,40,120]);
  toast('💥 로프가 끊어졌어요!', 2000);
  if(S.mode==='host') net.send({t:'snap'});
  setTimeout(()=>endRound('over'), 1600);     // 끊어진 뒤 잠깐 떨어지는 모습 보여주고 종료
}
let creakAt=0;
function strainFeedback(){
  if(S.ropeBroken || S.phase!=='run') return;
  if(S.strain>=ROPE.WARN){
    if(!S.warned){ S.warned=true; toast('⚠️ 로프가 끊어지려 해요! 빨리 올라가요', 1800); }
    const gap = 520 - S.strain*320;
    if(now()-creakAt>gap){ creakAt=now(); sfx(140+S.strain*120,.07,'sawtooth',.035); if(navigator.vibrate && S.strain>.85) navigator.vibrate(25); }
  } else if(S.strain<ROPE.WARN*.5) S.warned=false;
}
function registerFall(id, m, local){
  S.falls++; sfx(220,.25,'triangle',.06); setTimeout(()=>sfx(150,.3,'triangle',.05),120);
  toast(`😱 ${id} ${m}m 추락!`, 1600);
  if(local) net.send({t:'fall', id, m});
}

function doJump(p, assist){
  p.vy=-PHYS.JUMP_V; p.holding=true; p.jumpT=0; p.buf=0; p.coyote=0; p.grounded=false;
  if(assist){ p.assistCd=ROPE.ASSIST_CD; popFx('로프 점프!', '#ffcf4a', p); sfx(700,.12,'triangle'); } else sfx(420,.08,'triangle',.04);
}

function stepBody(id, dt){
  const p=S.pl[id], inp=inputOf(id), q=partnerOf(id), rope=S.ropeBroken?null:q;   // q: 친구 몸(머리 밟기), rope: 줄 효과
  // 좌우 이동
  const dir=(inp.right?1:0)-(inp.left?1:0), ice=p.grounded && p.gTile==='~';
  if(!p.grounded) p.peakY=Math.min(p.peakY, p.y);
  if(dir){ p.vx += dir*(p.grounded?PHYS.ACCEL*(ice?PHYS.ICE_ACCEL:1):PHYS.AIR_ACCEL)*dt; if(Math.abs(p.vx)>PHYS.RUN && Math.sign(p.vx)===dir) p.vx=dir*Math.max(PHYS.RUN, Math.abs(p.vx)-PHYS.FRICTION*dt); p.face=dir; }
  else { const f=(p.grounded?(ice?PHYS.ICE_FRICTION:PHYS.FRICTION):300)*dt; p.vx = Math.abs(p.vx)<=f ? 0 : p.vx-Math.sign(p.vx)*f; }
  // 점프 (버퍼 + 코요테 타임 + 로프 보조)
  if(inp.jump && !p.prevJump) p.buf=PHYS.BUFFER;
  p.prevJump=inp.jump;
  p.buf-=dt; p.coyote = p.grounded ? PHYS.COYOTE : p.coyote-dt; p.assistCd=(p.assistCd||0)-dt;
  if(p.buf>0){
    if(p.coyote>0) doJump(p,false);
    else if((p.assistCd||0)<=0 && rope && q.grounded && (q.y+q.h) < (p.y+p.h) - ROPE.ASSIST_DY) doJump(p,true);
  }
  // 가변 점프 높이: 누르고 있으면 중력 감소, 떼면 상승 속도 컷
  if(p.holding){
    if(!inp.jump){ p.holding=false; if(p.vy<0) p.vy*=PHYS.CUT; }
    else if((p.jumpT+=dt) >= PHYS.HOLD_T) p.holding=false;
  }
  p.vy = Math.min(PHYS.MAX_FALL, p.vy + PHYS.GRAVITY*((p.holding&&p.vy<0)?PHYS.HOLD_GRAV:1)*dt);
  // 고무줄 탄성
  if(rope){ const dx=(q.x+q.w/2)-(p.x+p.w/2), dy=(q.y+q.h/2)-(p.y+p.h/2), d=Math.hypot(dx,dy);
    if(d>ROPE.REST){ const a=Math.min(ROPE.AMAX, ROPE.K*(d-ROPE.REST)); p.vx+=dx/d*a*dt; p.vy+=dy/d*a*dt; } }
  p.vx=clamp(p.vx,-320,320);
  // 이동 + 충돌
  if(p.onMover!=null){ const m=MV[p.onMover];                       // 이동 발판 위: 함께 이동
    moveX(p, m.dX); if(m.dY<0) moveY(p, m.dY, null); else p.y+=m.dY; }
  const carried = p.onPartner && q;
  if(carried) moveX(p, q.vx*dt);
  moveX(p, p.vx*dt);
  p.grounded=false; p.onPartner=false; p.onMover=null;
  moveY(p, p.vy*dt, q);
  p.x=clamp(p.x, 0, WORLD_W-p.w);
  // 최대 로프 길이 제한
  if(rope){ const dx=(q.x+q.w/2)-(p.x+p.w/2), dy=(q.y+q.h/2)-(p.y+p.h/2), d=Math.hypot(dx,dy);
    if(d>ROPE.MAX){ const nx=dx/d, ny=dy/d, ex=(d-ROPE.MAX)*(S.mode==='solo'?.5:.7);
      moveX(p,nx*ex); moveY(p,ny*ex,null);
      const out=-(p.vx*nx+p.vy*ny); if(out>0){ p.vx+=nx*out; p.vy+=ny*out; ropeJerk(out); } } }
  // 끼임 해소 (실패하면 마지막 안전 위치로)
  // 살짝 겹침 → 밀어내기 / 깊게 겹침 → 직전 안전 위치로 되돌림
  if(unstick(p, 14)){ p.safeX=p.x; p.safeY=p.y; }
  else { p.x=p.safeX; p.y=p.safeY; p.vx=0; p.vy=0; unstick(p); }
  checkEvents(id);
}

/* ---------- 판정 (내 캐릭터만 내 기기에서 판정 → 상대에게 전송) ---------- */
const overlap=(a,b)=>a.x<b.x+b.w && a.x+a.w>b.x && a.y<b.y+b.h && a.y+a.h>b.y;
function checkEvents(id){
  const p=S.pl[id], t=gameTime();
  if(p.y > WORLD_H+30) return die(id);                                  // 낭떠러지
  const tx0=Math.floor(p.x/TS), tx1=Math.floor((p.x+p.w-1)/TS), ty0=Math.floor(p.y/TS), ty1=Math.floor((p.y+p.h-1)/TS);
  for(let ty=ty0;ty<=ty1;ty++) for(let tx=tx0;tx<=tx1;tx++)            // 가시
    { const c=tileAt(tx,ty);
      if(c==='^' && overlap(p,{x:tx*TS+4,y:ty*TS+10,w:TS-8,h:TS-10})) return die(id);
      if(c==='L' && overlap(p,{x:tx*TS,y:ty*TS+6,w:TS,h:TS-6})) return die(id); }
  for(const e of ENEMIES){ if(S.kills.has(e.i)) continue;               // 적
    const box={x:enemyX(e,t), y:e.y, w:e.w, h:e.h};
    if(overlap(p,box)){
      if(p.vy>0 && p.y+p.h-p.vy/120 <= box.y+8){ S.kills.add(e.i); net.send({t:'kill',i:e.i}); p.vy=-PHYS.STOMP_V; p.airUsed=false;
        sfx(260,.12,'square'); popFx('꾹!','#fff',p); }
      else return die(id);
    } }
  for(const c of COINS){ if(S.coins.has(c.i)) continue;                 // 코인
    if(Math.abs(p.x+p.w/2-c.x)<16 && Math.abs(p.y+p.h/2-c.y)<20){ S.coins.add(c.i); net.send({t:'coin',i:c.i}); sfx(988,.08,'triangle'); sfx(1319,.12,'triangle',.03); } }
  const hm=heightM(p.y); if(p.grounded && hm>S.best) S.best=hm;
  for(let z=ZONES.length-1; z>S.zone; z--) if(hm>=ZONES[z].m){ S.zone=z; toast('📍 '+ZONES[z].name, 2000); break; }
  for(const c of CPS){ if(c.i>S.cp && p.x>=c.x){ S.cp=c.i; net.send({t:'cp',i:c.i}); toast('🚩 체크포인트!'); sfx(660,.15,'triangle'); } }
  const atGoal = p.grounded && Math.abs(p.x+p.w/2-(GOAL_X+TS/2))<TS*3 && Math.abs(p.y+p.h-(GOAL_Y+TS))<TS*.6;
  if(atGoal && !S.goals.has(id)){ reachGoal(id); net.send({t:'goal',id}); }
  else if(!atGoal && S.goals.has(id) && S.phase==='run'){ S.goals.delete(id); net.send({t:'ungoal',id}); }
}
// 문: 누군가(나 또는 친구) 버튼 위에 있으면 열림, 문 안에 누가 끼어 있으면 닫히지 않음
function updateDoor(){
  const bodies=[...localIds().map(id=>S.pl[id])], q=S.mode==='solo'?null:partnerOf(S.me); if(q) bodies.push(q);
  const pressed=BUTTONS.some(b=>bodies.some(p=>overlap(p,{x:b.x+3,y:b.y+TS-8,w:TS-6,h:8})));
  let stuck=false;
  if(DOOR.open && !pressed) for(const p of bodies){ const tx0=Math.floor(p.x/TS), tx1=Math.floor((p.x+p.w-1)/TS), ty0=Math.floor(p.y/TS), ty1=Math.floor((p.y+p.h-1)/TS);
    for(let ty=ty0;ty<=ty1;ty++) for(let tx=tx0;tx<=tx1;tx++) if(tileAt(tx,ty)==='d') stuck=true; }
  if(pressed!==DOOR.open && !stuck){ DOOR.open=pressed; sfx(pressed?520:260,.1,'square',.03); }
}
function die(id){ if(S.phase!=='run' || now()<S.deadUntil) return; net.send({t:'die',id}); teamDie(id); }
function teamDie(id){
  if(now()<S.deadUntil || S.phase!=='run') return;
  S.deaths++; S.deadUntil=now()+900; S.goals.clear();
  sfx(150,.35,'sawtooth',.07); if(navigator.vibrate) navigator.vibrate(90);
  toast(`💥 ${id} 실수! 둘 다 ${S.cp<0?'시작점':'체크포인트'}으로`);
  setTimeout(()=>{ if(S.phase!=='run') return;
    for(const lid of localIds()){ const b=makeBody(lid); S.pl[lid]=b; S.disp[lid]={x:b.x,y:b.y}; }
    if(S.remote){ const s=spawnPos(other(S.me)); Object.assign(S.remote,{x:s.x,y:s.y,vx:0,vy:0,at:now()}); }
  }, 850);
}
function reachGoal(id){ if(S.goals.has(id)) return; S.goals.add(id); if(S.goals.size===1) toast(`🏁 ${id} 정상 도착! 친구를 기다려요`); if(S.goals.size>=2) endRound('clear'); }
function endRound(kind){ if(S.phase==='over'||S.phase==='clear') return; S.endT=(now()-S.startAt)/1000; S.phase=kind; clearInput(); setTimeout(showResult,700); }
function popFx(text,color,p){ S.fx.push({text,color,x:p.x+p.w/2,y:p.y-14,t0:now()}); }

/* =========================================================
   온라인 (PeerJS) — 방장 P1 / 참여자 P2
   각자 자기 캐릭터를 계산, 위치를 초당 20회 전송
   ========================================================= */
const net={ peer:null, conn:null, code:'', off:0, bestRtt:1e9, syncN:0, joinTimer:null, lastSend:0,
  send(m){ if(this.conn&&this.conn.open) this.conn.send(m); },
  close(){ clearTimeout(this.joinTimer); try{this.conn&&this.conn.close();}catch(e){} try{this.peer&&this.peer.destroy();}catch(e){} this.peer=null; this.conn=null; } };
const ROOM_PREFIX='duorope-v1-', CODE_CHARS='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
const genCode=()=>Array.from({length:4},()=>CODE_CHARS[Math.floor(Math.random()*CODE_CHARS.length)]).join('');
const lobbyStatus=t=>$('#lobbyStatus').textContent=t;
function needPeer(){ if(window.Peer) return true; lobbyStatus('온라인 연결 모듈을 불러오지 못했어요. 인터넷 연결을 확인하세요.'); return false; }

function createRoom(){
  if(!needPeer()) return;
  net.close(); lobbyStatus('코드 만드는 중…');
  const code=genCode(), peer=net.peer=new Peer(ROOM_PREFIX+code);
  peer.on('open',()=>{ S.mode='host'; S.me='P1'; net.code=code; $('#waitCode').textContent=code; show('#ovWait'); lobbyStatus(''); });
  peer.on('connection',c=>{ if(net.conn&&net.conn.open){ c.on('open',()=>{ c.send({t:'full'}); setTimeout(()=>c.close(),300); }); return; } bindConn(c); });
  peer.on('error',e=>{ if(e.type==='unavailable-id') createRoom(); else netError(e); });
}
function joinRoom(code){
  code=(code||'').trim().toUpperCase();
  if(code.length!==4) return lobbyStatus('4자리 코드를 입력하세요.');
  if(!needPeer()) return;
  net.close(); lobbyStatus('입장하는 중…'); S.mode='guest'; S.me='P2'; net.code=code;
  const peer=net.peer=new Peer();
  peer.on('open',()=>bindConn(peer.connect(ROOM_PREFIX+code,{reliable:true})));
  peer.on('error',netError);
  net.joinTimer=setTimeout(()=>{ if(S.phase==='idle') netError({type:'timeout'}); },12000);
}
function bindConn(c){
  net.conn=c;
  c.on('open',()=>{ if(S.mode==='guest'){ net.bestRtt=1e9; net.syncN=0; c.send({t:'sync',c:now()}); lobbyStatus('연결됨! 준비 중…'); }
                    else { hide('#ovWait'); toast('친구가 들어왔어요!'); } });
  c.on('data',onData);
  c.on('close',()=>{ if(net.conn===c) showMsg('연결 종료','상대방과의 연결이 끊겼어요.'); });
}
function netError(e){
  const map={'peer-unavailable':'해당 코드의 방이 없어요. 코드를 다시 확인하세요.','timeout':'입장하지 못했어요. 코드를 확인하고 다시 시도하세요.',
             'full':'이미 2명이 플레이 중인 방이에요.','network':'네트워크 연결이 불안정해요.'};
  const msg=map[e.type]||'연결 오류가 발생했어요. 다시 시도하세요.';
  if(S.phase!=='idle') showMsg('연결 오류',msg); else { hide('#ovWait'); lobbyStatus(msg); }
  net.close();
}
function onData(m){
  switch(m.t){
    case 'sync':  net.send({t:'syncR',c:m.c,h:now()}); break;
    case 'syncR': { const rtt=now()-m.c; if(rtt<net.bestRtt){ net.bestRtt=rtt; net.off=m.h+rtt/2-now(); }
                    if(++net.syncN<5) net.send({t:'sync',c:now()}); else net.send({t:'ready'}); break; }
    case 'ready': startRound(); break;
    case 'again': if(S.mode==='host') startRound(); break;
    case 'start': clearTimeout(net.joinTimer); beginRound(m.at-net.off); break;
    case 's':     if(S.remote && S.phase!=='idle'){ const r=S.remote;
                    if(Math.hypot(m.x-r.x,m.y-r.y)>120){ S.disp[other(S.me)]={x:m.x,y:m.y}; }   // 리스폰 등 순간이동
                    Object.assign(r,{x:m.x,y:m.y,vx:m.vx,vy:m.vy,grounded:!!m.g,face:m.f,at:now()});
                    if(m.r!==undefined && S.mode==='guest' && !S.ropeBroken) S.strain=m.r; } break;
    case 'jerk':  if(ropeJudge()) addStrain(m.a); break;
    case 'snap':  if(!S.ropeBroken) snapRope(); break;
    case 'coin':  S.coins.add(m.i); sfx(988,.06,'triangle',.03); break;
    case 'kill':  S.kills.add(m.i); sfx(260,.1,'square',.03); break;
    case 'cp':    if(m.i>S.cp){ S.cp=m.i; toast('🚩 체크포인트!'); } break;
    case 'goal':  reachGoal(m.id); break;
    case 'ungoal': S.goals.delete(m.id); break;
    case 'fall':  registerFall(m.id, m.m, false); break;
    case 'die':   teamDie(m.id); break;
    case 'full':  netError({type:'full'}); break;
  }
}

/* =========================================================
   라운드
   ========================================================= */
function startRound(){ const at=now()+GAME.COUNTDOWN; if(S.mode==='host') net.send({t:'start',at}); beginRound(at); }
function beginRound(at){
  resetRound(); clearInput(); S.startAt=at; S.phase='count';
  hide('#lobby'); hide('#ovWait'); hide('#ovResult'); hide('#ovMsg'); show('#game');
  updateMe(); resize();
}
function requestRestart(){ if(S.mode==='guest') net.send({t:'again'}); else startRound(); }
function goLobby(){ net.close(); S.phase='idle'; S.mode='solo'; clearInput();
  hide('#game'); hide('#ovWait'); hide('#ovResult'); hide('#ovMsg'); show('#lobby'); lobbyStatus(''); }
function showMsg(title,text){ S.phase='idle'; $('#msgTitle').textContent=title; $('#msgText').textContent=text; show('#ovMsg'); net.close(); }
function updateMe(){
  const el=$('#hudMe'), solo=S.mode==='solo', touchUI=document.body.classList.contains('touch');
  el.textContent = solo ? (touchUI ? S.me : '테스트') : `나 ${S.me}`;
  el.style.background = (!solo || touchUI) ? PLAYERS[S.me].color : '';
  $('#btnJump').style.setProperty('--c', PLAYERS[S.me].color);
  $('#btnSwap').hidden = !(solo && touchUI);
}
const SUMMIT_M = heightM(GOAL_Y+TS-PHYS.H);
const progressPct = () => clamp(Math.round(S.best/SUMMIT_M*100),0,100);
function showResult(){
  const clear=S.phase==='clear';
  const stars = clear ? 1 + (S.falls<=3?1:0) + (S.falls===0?1:0) : 0;
  $('#resTitle').textContent = clear ? '정상 정복!' : S.snapped ? '💥 로프 끊어짐! 탈락' : '여기까지…';
  $('#resStars').textContent = '★'.repeat(stars)+'☆'.repeat(3-stars);
  $('#resA').textContent = clear ? fmt(S.endT) : progressPct()+'%';
  $('#resALabel').textContent = clear ? '기록' : '진행률';
  $('#resB').textContent = `${S.best}m`;
  $('#resC').textContent = `${S.falls}회`;
  show('#ovResult');
  if(clear){ sfx(523,.12,'triangle'); setTimeout(()=>sfx(659,.12,'triangle'),120); setTimeout(()=>sfx(784,.25,'triangle'),240); }
}
async function shareOrCopy(text,url){
  try{ if(navigator.share){ await navigator.share({title:'듀오 로프',text,url}); return; } }catch(e){ if(e.name==='AbortError') return; }
  const full=url?text+'\n'+url:text;
  try{ await navigator.clipboard.writeText(full); }
  catch(e){ const ta=document.createElement('textarea'); ta.value=full; document.body.appendChild(ta); ta.select(); try{document.execCommand('copy');}catch(_){} ta.remove(); }
