  const band=(stops)=>{ const n=stops.length-1, f=Math.min(n-1e-6,k*n), i=Math.floor(f); return mix(stops[i],stops[i+1],f-i); };
  const top=band(['#8fd3ff','#5fb6ff','#ffb27a','#2b2f6b']), bot=band(['#d9f5e0','#e2f5ff','#ffe2b8','#5a4f9e']);
  const sky=c.createLinearGradient(0,0,0,VH); sky.addColorStop(0,top); sky.addColorStop(1,bot);
  c.fillStyle=sky; c.fillRect(0,0,VW,VH);
  if(k>.6){ c.fillStyle=`rgba(255,255,255,${(k-.6)*2})`;                      // 정상 근처 별
    for(let i=0;i<40;i++){ const x=(i*97)%VW, y=((i*53 - camY*.05)%VH+VH)%VH; c.fillRect(x,y,2,2); } }
  c.fillStyle='rgba(255,255,255,.75)';
  for(let i=0;i<8;i++){ const x=((i*170-camX*.1)%1200+1200)%1200-100, y=((i*97 - camY*.25)%(VH+80)+VH+80)%(VH+80)-40;
    c.beginPath(); c.ellipse(x,y,36,12,0,0,Math.PI*2); c.ellipse(x+24,y-8,22,11,0,0,Math.PI*2); c.fill(); }
  const lift=(WORLD_H-VH-camY)*.3;                                      // 산은 바닥 근처에서만 보임
  if(lift<VH) { hill('#b9e6cb',.25,60,VH-70+lift,170); hill('#86cfa2',.5,40,VH-30+lift,120); }
  { const d=START_DECOR, im=IMAGES[d.img]._img, bw=d.w*TS, bh = imgReady(im) ? bw*im.naturalHeight/im.naturalWidth : TS*4;   // 시작 건물
    const bx=d.x*TS-camX, by=FLOOR_Y-bh-camY; if(by<VH && by+bh>0) drawImg(c,d.img,bx,by,bw,bh); }
  c.save(); c.translate(-Math.round(camX), -Math.round(camY));
