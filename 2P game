const TS=PHYS.TILE, MW=MAP[0].length, MH=MAP.length, WORLD_W=MW*TS, WORLD_H=MH*TS;
const grid=MAP.map(r=>r.split(''));
const COINS=[], ENEMIES=[], CPS=[], BUTTONS=[], STARTS={}; let GOAL_X=WORLD_W-TS*4, GOAL_Y=WORLD_H-TS*3;
const DOOR = { open:false };
const isSolid = c => c==='#' || c==='B' || c==='P' || c==='S' || c==='~' || c==='=' || (c==='d' && !DOOR.open);
const tileAt = (tx,ty) => (tx<0||tx>=MW) ? '#' : (ty<0||ty>=MH) ? ' ' : grid[ty][tx];
(function parse(){
  for(let y=0;y<MH;y++) for(let x=0;x<MW;x++){
    const c=grid[y][x];
    if(c==='1'||c==='2'){ STARTS[c==='1'?'P1':'P2']={x:x*TS+(TS-PHYS.W)/2, y:(y+1)*TS-PHYS.H}; grid[y][x]=' '; }
    else if(c==='o'){ COINS.push({i:COINS.length, x:x*TS+TS/2, y:y*TS+TS/2}); grid[y][x]=' '; }
    else if(c==='C'){ CPS.push({i:CPS.length, x:x*TS, y:y*TS}); grid[y][x]=' '; }
    else if(c==='G'){ GOAL_X=x*TS; GOAL_Y=y*TS; grid[y][x]=' '; }
    else if(c==='b'){ BUTTONS.push({x:x*TS, y:y*TS}); }
    else if(c==='e'){ grid[y][x]=' ';
      let a=x, b=x;                                  // 순찰 범위: 막히거나 낭떠러지 전까지 최대 4칸
      const floor=(tx)=>isSolid(tileAt(tx,y+1)) || tileAt(tx,y+1)==='=';
      while(a>x-4 && !isSolid(tileAt(a-1,y)) && floor(a-1)) a--;
      while(b<x+4 && !isSolid(tileAt(b+1,y)) && floor(b+1)) b++;
      ENEMIES.push({i:ENEMIES.length, left:a*TS+1, range:(b-a+1)*TS-24, y:(y+1)*TS-20, w:22, h:20, phase:x*.7}); }
  }
})();
const enemyX = (e,t) => { const r=Math.max(1,e.range), s=((Math.max(0,t)*40+e.phase*TS)%(2*r)+2*r)%(2*r); return e.left + (s<r ? s : 2*r-s); };
const enemyDir = (e,t) => { const r=Math.max(1,e.range), s=((Math.max(0,t)*40+e.phase*TS)%(2*r)+2*r)%(2*r); return s<r ? 1 : -1; };

