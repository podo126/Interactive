      c.fillStyle='#5f6b8a'; rr(c,X+(lf?0:1),Y+(up?0:1),TS-(lf?0:1)-(rt?0:1),TS-(up?0:1)-(dn?0:1),lf&&rt?0:5); c.fill();
      c.fillStyle='#7f8bab'; c.fillRect(X+(lf?0:3),Y+(up?0:3),TS-(lf?0:3)-(rt?0:3),5);
      c.fillStyle='#4a5470'; c.fillRect(X+(lf?0:3),Y+TS-5,TS-(lf?0:3)-(rt?0:3),3);
