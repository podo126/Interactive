      else if(v===1){ c.moveTo(X+15,Y+9); c.lineTo(X+18,Y+13); } c.stroke();
      if(!up){ c.fillStyle='#7ccc5a'; c.fillRect(X+(lf?0:2),Y,TS-(lf?0:2)-(rt?0:2),3); c.fillRect(X+5+((tx*5)%9),Y+3,3,2); } }
    else if(ch==='P'){ // 나무 그루터기: 세로 결 + 윗면 나이테
      const top=tileAt(tx,ty-1)!=='P', L=tileAt(tx-1,ty)!=='P', R=tileAt(tx+1,ty)!=='P';
      c.fillStyle='#8a5a34'; c.fillRect(X+(L?2:0),Y,TS-(L?2:0)-(R?2:0),TS);
      c.fillStyle='#6e4527'; for(let i=0;i<3;i++) c.fillRect(X+4+i*7+((tx+ty)%2),Y+(i%2?2:6),2,TS-8);
      if(L){ c.fillStyle='#a8744a'; c.fillRect(X+2,Y,3,TS); } if(R){ c.fillStyle='#5a381f'; c.fillRect(X+TS-5,Y,3,TS); }
      if(top){ c.fillStyle='#d9b07a'; c.fillRect(X+(L?2:0),Y,TS-(L?2:0)-(R?2:0),7);
        c.strokeStyle='#b2834f'; c.lineWidth=1.2; c.beginPath(); c.ellipse(X+(L?TS:0)+(L&&R?-TS/2:0),Y+3.5,L&&R?6:8,2,0,0,Math.PI*2); c.stroke();
        c.fillStyle='#6cc24a'; if(L) c.fillRect(X+2,Y+6,5,3); if(R) c.fillRect(X+TS-8,Y+6,4,3); } }
